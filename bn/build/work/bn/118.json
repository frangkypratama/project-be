 "verses": [
  [
   "Lindungilah ya Tuhan seluruh umatMu agar tak disesatkan godaan seteru"
  ],
  [
   "Biarkanlah firman-Mu selalu bekerja",
   "Agar hidup umat-Mu damai sejahtera"
  ],
  [
   "Pancarkanlah sinar-Mu di hati umat-Mu",
   "Agar tidak keliru menuju rumah-Mu"
  ],
  [
   "Limpahkan pada kami, anug'rah berkat-Mu",
   "Gandakan tiap hari kasih karunia-Mu"
  ],
  [
   "Lindungilah selalu umat-Mu Tuhanku",
   "Agar menang selalu melawan seteru"
  ],
  [
   "Abadikan ya, Tuhan kasih setia-Mu",
   "Berikan ketekunan, enyahkan seteru"
  ]
