  [
   "Hai bangkit bagi Yesus pasukan salibNya Bersama Tuhan Yesus maju ke medan p'rang Dengan tekun berjuang engkau pasti menang dan musuh Tuhan kita pasti dikalahkan"
  ],
  [
   "Dengarkan panggilan-Nya melawan seteru",
   "Ikuti perintah-Nya melawan dosamu",
   "Bersama dengan Tuhan menghadang musuhmu",
   "Percayalah selalu kepada Tuhanmu"
