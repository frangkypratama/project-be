 "verses": [
  [
   "Yesus b'rilah pertolongan kapan dan dimanapun",
   "Memasuki tahun baru mengikutiMu tekun",
   "Bimbing dan berkatilah umatMu selamanya"
  ],
  [
   "Pikiran, perbuatanku memuliakan nama-Mu",
   "Saat tidur maupun bangun, Kau tetap bersamaku",
   "Masuk dan keluar pun Tuhan, Kau penolongku"
  ],
  [
   "Ini tahun pengasihan, rahmat Tuhan bagiku",
   "Dan berilah pengampunan atas dosa-dosaku",
   "Hanya oleh darah-Mu, Kau sucikan hatiku"
  ],
  [
   "Tuhan hiburlah hatiku dengan kasih sayang-Mu",
   "Dan terimalah doaku oleh kemurahan-Mu",
   "Singkirkanlah musuhku yang dukakan hatiku"
  ],
  [
   "Dan teguhkanlah hatiku meninggalkan dosaku",
   "Tabah dan tekun selalu melakukan firman-Mu",
   "Pimpin aku hamba-Mu mengikuti jalan-Mu"
  ],
  [
   "Pada tahun baru ini, pimpin aku anak-Mu",
   "Bila umurku berakhir, Tuhan pegang tanganku",
   "Akan senang hatiku memasuki rumah-Mu"
  ]
 ],
